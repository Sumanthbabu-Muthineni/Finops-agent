# ==============================================================================
# TBX FinOps Assistant - Environment Configuration Template
# Copy this file to .env and supply your credentials: cp .env.example .env
# ==============================================================================

# Primary LLM Provider: 'bedrock' (Recommended), 'ollama' (Local), or 'groq'
LLM_PROVIDER=bedrock

# AWS Bedrock Configuration
# Models available for latency, hallucination, and scale evaluation:
# - Default 8B:  us.meta.llama3-1-8b-instruct-v1:0 (Meta Llama 3.1 8B Instruct)
# - 3B Model:    mistral.ministral-3-3b-instruct   (Mistral Ministral 3B - ultra-fast ~540ms)
# - 3B Micro:    amazon.nova-micro-v1:0             (Amazon Nova Micro)
# - 4B Model:    google.gemma-3-4b-it               (Google Gemma 3 4B IT)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.meta.llama3-1-8b-instruct-v1:0

# Local Ollama Settings (Optional - when running fully offline)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Groq Cloud Settings (Optional secondary fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Database Configuration (PostgreSQL Native - B-Tree Indexed)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Server & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
DEBUG=true

# Evaluator UTR Hash / Encryption Key (used for deterministic encryption of utr_number in PostgreSQL)
HASH_KEY=finops-evaluator-secret-hashkey-2026
